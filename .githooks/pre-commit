#!/usr/bin/env bash

set -e

echo "[SECURITY] Scanning staged files for secrets..."

STAGED_CONTENT="$(git diff --cached --no-ext-diff --unified=0 --text)"

if printf '%s\n' "$STAGED_CONTENT" | \
    grep -qE 'https://(discord\.com|discordapp\.com)/api/webhooks/[0-9]+/[A-Za-z0-9._-]+'; then

    echo
    echo "[SECURITY] BLOCKED: Discord webhook detected in staged changes."
    echo "[SECURITY] Move the secret to .env before committing."
    exit 1
fi

if printf '%s\n' "$STAGED_CONTENT" | \
    grep -qE 'BEGIN (RSA |EC |OPENSSH |DSA )?PRIVATE KEY'; then

    echo
    echo "[SECURITY] BLOCKED: private key detected in staged changes."
    exit 1
fi

echo "[SECURITY] No obvious secrets detected."
exit 0
